{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DMXtract Bridge",
  "version": "0.1.0",
  "identifier": "run.sho.dmxtract.bridge",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DMXtract Bridge",
        "width": 640,
        "height": 420,
        "visible": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["dmxtract"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/dmxtract_bridge"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
