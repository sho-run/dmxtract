# Optional server-side fixture lookup. Never expose these through Flutter build
# defines, client JavaScript, MCP tool results, or a committed .env file.
DMXTRACT_FIXTURE_LOOKUP_URL=https://your-private-api.example/v1/fixture-matches
DMXTRACT_FIXTURE_LOOKUP_TOKEN=replace-in-host-secret-manager
DMXTRACT_FIXTURE_LINK_HOSTS=gdtf-share.com,www.gdtf-share.com

# Alternatively, connect the server-side function directly to GDTF Share.
# Store live values in the host secret manager, never in this file.
GDTF_SHARE_USERNAME=replace-in-host-secret-manager
GDTF_SHARE_PASSWORD=replace-in-host-secret-manager
